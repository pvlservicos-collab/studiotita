# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NUNCA versione o .env.local (já está no .gitignore).

# --- Banco de dados (Vercel Neon / Postgres) -------------------------------
# Pegue a connection string em: Vercel > Storage > seu banco Neon > .env.local tab
DATABASE_URL=postgres://usuario:senha@host/dbname?sslmode=require

# --- Gemini (análise de vídeo) ---------------------------------------------
# Crie uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ajuste para o modelo com suporte a vídeo mais recente disponível na sua conta.
GEMINI_MODEL=gemini-2.5-pro

# --- Meta Graph API (Instagram) ---------------------------------------------
# Token de acesso de longa duração de uma conta profissional do Instagram
# vinculada a uma Página do Facebook. Veja o passo a passo no README.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_IG_USER_ID=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Vercel Blob (opcional — cópias de vídeo) --------------------------------
BLOB_READ_WRITE_TOKEN=

# --- MCP (acesso do Claude Code do cliente) ----------------------------------
# Gere uma chave forte, por exemplo: openssl rand -hex 32
MCP_API_KEY=
